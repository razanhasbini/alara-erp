# ÀLara Line ERP — configuration template. NO real values in this file.
# In development these live in dotnet user-secrets (see README → Configuration).
# In production set them as environment variables (ASP.NET reads "__" as ":").

# Runtime connection: DML-only role (SELECT/INSERT/UPDATE/DELETE), never a superuser.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=alara_erp;Username=alara_app;Password=CHANGE_ME
# Migrations connection: schema-owner role, used only by the `migrate` command.
ConnectionStrings__Migrations=Host=localhost;Port=5432;Database=alara_erp;Username=alara_owner;Password=CHANGE_ME

# Integration tests only — the database name MUST end in "_test" (the test suite refuses anything else).
ConnectionStrings__TestApp=Host=localhost;Port=5432;Database=alara_erp_test;Username=alara_app;Password=CHANGE_ME
ConnectionStrings__TestOwner=Host=localhost;Port=5432;Database=alara_erp_test;Username=alara_owner;Password=CHANGE_ME

ASPNETCORE_ENVIRONMENT=Production
# Session cookie: Always in production (HTTPS). Development uses SameAsRequest (see appsettings.Development.json).
Auth__CookieSecurePolicy=Always
Auth__SessionHours=8
Auth__SessionRevalidationInterval=00:01:00
Auth__LoginAttemptsPerMinute=10

# Business settings
Erp__BaseCurrency=USD
Erp__TimeZone=Asia/Beirut
Erp__DefaultDeliveryFee=4.00
Erp__ExpiryWarningDays=60

# Product images (relative to the API content root, or absolute). Keep outside any web root; back it up.
Storage__LocalPath=App_Data/uploads

# Background jobs (reservation-deadline alerts, WhatsApp sending)
Jobs__Enabled=true
Jobs__IntervalSeconds=60
# Public address of the app, used for links inside WhatsApp alerts
App__FrontendUrl=

# WhatsApp alerts via Meta Cloud API. Leave Enabled=false until the business number is connected;
# alerts are still recorded in the app's Alerts page.
WhatsApp__Enabled=false
WhatsApp__PhoneNumberId=
WhatsApp__AccessToken=
WhatsApp__ApiVersion=v21.0
WhatsApp__Recipients__0=
WhatsApp__TemplateName=
WhatsApp__TemplateLanguage=en

# One-time admin bootstrap (prefer the interactive prompt; never commit these).
# Bootstrap__AdminEmail=
# Bootstrap__AdminFirstName=
# Bootstrap__AdminLastName=
# Bootstrap__AdminPassword=

# Frontend dev server: where Vite proxies /api (default http://localhost:5190)
# ALARA_API_URL=http://localhost:5190
